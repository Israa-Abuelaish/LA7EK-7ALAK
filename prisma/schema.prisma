datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  }

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  merchant
  customer
}

// ==========================================
// 1. جدول المستخدمين الأساسي (User Schema)
// ==========================================
model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  phone    String?
  role     Role   @default(customer)

  status String @default("active")

  // حقول الـ OTP لاستعادة كلمة المرور أو التحقق
  otpCode      String?
  otpExpiresAt DateTime?

  // العلاقات
  customerProfile Customer?
  merchantProfile Merchant?
  notifications   Notification[]
  reports         Report[]       @relation("UserReports")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Store     Store[]
}

// ==========================================
// 2. جدول الزبائن (Customer Schema)
// ==========================================
model Customer {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone   String?
  address String?

  // العلاقات
  ratings Rating[]
  follows Follow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 3. جدول التجار (Merchant Schema)
// ==========================================
model Merchant {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  storeName    String
  commercialNo String? // السجل التجاري أو رقم الترخيص

  // العلاقات
  stories       Story[]
  wallet        MerchantWallet?
  ratings       Rating[]
  followers     Follow[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 4. جدول التصنيفات (Category Schema)
// ==========================================
model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  icon   String? // الأيقونة كما ظهرت في البيانات الوهمية
  stores Store[]
}

// ==========================================
// 5. جدول المدن 
// ==========================================
model City {
  id          Int     @id @default(autoincrement())
  governorate String // المحافظة مثل: الوسطى، غزة
  area        String // المنطقة مثل: النصيرات، الرمال
  stores      Store[]
}

// ==========================================
// 5. جدول المتاجر
// ==========================================
model Store {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  visitCount  Int     @default(0) // عدد زيارات صفحة المتجر

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  cityId Int
  city   City @relation(fields: [cityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stories Story[]
  follows Follow[]
  ratings Rating[]
}

// ==========================================
// 6. جدول القصص والعروض (Story Schema)
// ==========================================
model Story {
  id         Int      @id @default(autoincrement())
  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  mediaUrl           String // رابط الصورة أو الفيديو
  description        String? // وصف القصة أو العرض
  discountPercentage Float? // نسبة الخصم إن وجدت

  status String @default("active") // active, expired, deleted_by_merchant, deleted_by_admin

  expiresAt DateTime // تحديد وقت انتهاء الـ 24 ساعة
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Store     Store?   @relation(fields: [storeId], references: [id])
  storeId   Int?
}

// ==========================================
// 7. جدول التقييمات والمتابعات (Ratings & Follows Schemas)
// ==========================================
model Rating {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  rating Int // عدد النجوم (من 1 إلى 5)
  review String? // تعليق الزبون

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Store     Store?   @relation(fields: [storeId], references: [id])
  storeId   Int?

  @@unique([customerId, merchantId])
}

model Follow {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  Store     Store?   @relation(fields: [storeId], references: [id])
  storeId   Int?

  @@unique([customerId, merchantId])
}

// ==========================================
// 8. جدول الرصيد والمحافظ (MerchantWallet & Transaction Schemas)
// ==========================================
model MerchantWallet {
  id         Int      @id @default(autoincrement())
  merchantId Int      @unique
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  balance      Float         @default(0.0) // الرصيد الحالي
  transactions Transaction[] // سجل العمليات

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id       Int            @id @default(autoincrement())
  walletId Int
  wallet   MerchantWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amount      Float // قيمة العملية (خصم، إيداع...)
  type        String // نوع العملية (مثل: "deduction", "deposit")
  description String? // تفاصيل العملية

  createdAt DateTime @default(now())
}

// ==========================================
// 9. جدول الاشتراكات والأمور المالية (Subscription Schema)
// ==========================================
model Subscription {
  id         Int      @id @default(autoincrement())
  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  planName String // اسم الباقة (مثل: Gold, Silver)
  price    Float // سعر الباقة

  // التفاصيل المالية
  paymentStatus String  @default("pending") // paid, pending, failed
  paymentMethod String? // طريقة الدفع
  transactionId String? // رقم مرجعي للعملية

  startDate DateTime @default(now())
  endDate   DateTime // تاريخ انتهاء الاشتراك
  status    String   @default("active") // active, expired, canceled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 10. جدول الإشعارات (Notification Schema)
// ==========================================
model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String // عنوان الإشعار
  message String // نص الإشعار
  isRead  Boolean @default(false)
  type    String? // نوع الإشعار

  createdAt DateTime @default(now())
}

// ==========================================
// 11. جدول التقارير والبلاغات (Report Schema)
// ==========================================
model Report {
  id         Int  @id @default(autoincrement())
  reporterId Int
  reporter   User @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType String // نوع العنصر المبلغ عنه (مثل: "story", "merchant")
  targetId   Int // معرف العنصر
  reason     String // سبب البلاغ
  status     String @default("pending") // pending, resolved, dismissed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
