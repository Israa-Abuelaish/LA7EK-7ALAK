datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// جدول المستخدمين (يشمل الزبائن، التجار، والأدمن)
model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  role          String   @default("customer")
  status        String   @default("active")
  resetToken    String?         // لتخزين الرمز المؤقت
  tokenExpiry   DateTime?       // وقت انتهاء صلاحية الرمز
  createdAt     DateTime @default(now())
  stores        Store[]
}

// جدول التصنيفات (Categories) لتصنيف المتاجر
model Category {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  stores  Store[] 
}

// جدول المناطق أو المدن (Locations/Cities)
model City {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  stores  Store[] 
}

// جدول المتاجر (Stores) المرتبط بالتاجر، التصنيف، والمدينة
model Store {
  id         Int      @id @default(autoincrement())
  name       String
  
  userId     Int            
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  categoryId Int             
  category   Category @relation(fields: [categoryId], references: [id])
  
  cityId     Int              
  city       City     @relation(fields: [cityId], references: [id])
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stories    Story[]
}


model Story {
  id        Int      @id @default(autoincrement())
  mediaUrl  String   // رابط الصورة أو الفيديو الخاص بالقصة
  caption   String?  // النص أو الوصف المرافق للقصة (اختياري)
  expiresAt DateTime // وقت انتهاء صلاحية القصة (عادة بعد 24 ساعة)
  createdAt DateTime @default(now())
  
  // العلاقات (Relations)
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id], onDelete:Cascade)
}