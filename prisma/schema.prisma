generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int            @id @default(autoincrement())
  name            String
  email           String         @unique
  password        String
  phone           String?
  role            Role           @default(customer)
  status          String         @default("active")
  otpCode         String?
  otpExpiresAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  customerProfile Customer?
  merchantProfile Merchant?
  notifications   Notification[]
  reports         Report[]       @relation("UserReports")
  Store           Store[]
}

model Customer {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  follows   Follow[]
  ratings   Rating[]
}

model Merchant {
  id            Int             @id @default(autoincrement())
  userId        Int             @unique
  storeName     String
  commercialNo  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  cityId        BigInt?
  city          Int?
  followers     Follow[]
  City          City?           @relation(fields: [city], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        MerchantWallet?
  ratings       Rating[]
  stories       Story[]
  subscriptions Subscription[]
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  icon   String?
  stores Store[]
}

model City {
  id          Int        @id @default(autoincrement())
  governorate String
  area        String
  latitude    Float?
  longitude   Float?
  Merchant    Merchant[]
  stores      Store[]
}

model Store {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  visitCount  Int      @default(0)
  userId      Int
  categoryId  Int
  cityId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  latitude    Float?
  longitude   Float?
  address     String?
  follows     Follow[]
  ratings     Rating[]
  category    Category @relation(fields: [categoryId], references: [id])
  city        City     @relation(fields: [cityId], references: [id])
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories     Story[]
}

model Story {
  id                 Int      @id @default(autoincrement())
  merchantId         Int
  mediaUrl           String
  description        String?
  discountPercentage Float?
  status             String   @default("active")
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  storeId            Int?
  merchant           Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  Store              Store?   @relation(fields: [storeId], references: [id])
}

model Rating {
  id         Int      @id @default(autoincrement())
  customerId Int
  merchantId Int
  rating     Int
  review     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  storeId    Int?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  Store      Store?   @relation(fields: [storeId], references: [id])

  @@unique([customerId, merchantId])
}

model Follow {
  id         Int      @id @default(autoincrement())
  customerId Int
  merchantId Int
  createdAt  DateTime @default(now())
  storeId    Int?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  Store      Store?   @relation(fields: [storeId], references: [id])

  @@unique([customerId, merchantId])
}

model MerchantWallet {
  id           Int           @id @default(autoincrement())
  merchantId   Int           @unique
  balance      Float         @default(0.0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id          Int            @id @default(autoincrement())
  walletId    Int
  amount      Float
  type        String
  description String?
  createdAt   DateTime       @default(now())
  wallet      MerchantWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Subscription {
  id            Int      @id @default(autoincrement())
  merchantId    Int
  planName      String
  price         Float
  paymentStatus String   @default("pending")
  paymentMethod String?
  transactionId String?
  startDate     DateTime @default(now())
  endDate       DateTime
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id         Int      @id @default(autoincrement())
  reporterId Int
  targetType String
  targetId   Int
  reason     String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  reporter   User     @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Receipt {
  id            BigInt?
  storeName     String?
  ownerName     String?
  amount        String?
  plan          String?
  transactionId String?
  date          String?
  receiptImg    String?
  status        String?
  created_at    DateTime? @db.Timestamptz(6)

  @@ignore
}

enum Role {
  admin
  merchant
  customer
}
